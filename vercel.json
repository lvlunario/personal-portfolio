{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/resume",
      "destination": "/index.html"
    },
    {
      "source": "/resume/",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/blog",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/Leonardo-Lunario-Resume.pdf",
      "destination": "/resume",
      "permanent": true
    }
  ]
}
